{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "baseUrl": ".",
        "paths": {
            "@shared/*": [
                "packages/shared/*"
            ]
        }
    }
}